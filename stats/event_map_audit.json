{
 "version": "event-map-audit-v1",
 "definitions": {
  "atomic_op": "一条「某旧列 → 某目标列 + 决定性表达式」的最小映射动作；键 = (evo, db, table, old_col)。段位档共 15 个。",
  "mapping_fact": "一个原子 op 连同其表达式映射 ID（M01…），是抽取质量的判定对象。",
  "change_event": "一次独立的列重整；键 = (evo, db, table, 目标列集合)。必须含 evo，否则合并与拆分的同名 attr_001 会被误并。",
  "db_cluster": "同一数据库上的全部变更；统计独立性的最粗单位（5 个库）。"
 },
 "containment": "op ⊂ mapping_fact（1:1）⊂ change_event（合并档每事件 2 op、拆分档每事件 1 op）⊂ db_cluster（每库 1–2 事件）。",
 "counts": {
  "atomic_ops": 15,
  "by_evo_ops": {
   "merge_col": 10,
   "split_col": 5
  },
  "events_correct": 10,
  "events_correct_by_evo": {
   "merge_col": 5,
   "split_col": 5
  },
  "events_v13_triplet": 7,
  "db_clusters": 5,
  "ops_with_segment_expr": 10,
  "ops_concat_expr": 5
 },
 "three_numbers": {
  "7": "第 13 轮按 (db, table, 表达式首个 attr_ 列) 三元组聚类的事件数。它既忽略 evo 档，又只取表达式里的第一个 attr_ 列，于是合并档的 SUBSTR(attr_001,…) 与拆分档的 attr_001||sep||attr_002 被归到同一键：5 个库中 3 个库（california_schools/formula_1/thrombosis_prediction）的合并与拆分共用同一表，各被并成 1 个事件，10 个正确事件因此塌缩为 7。此为口径缺陷，本版作废。",
  "10": "端到端池化 C3mp − c_rw 的「列重整事件」数 = 合并 5 + 拆分 5；也等于把 evo 纳入事件键后的正确聚类数。两者此刻一致。",
  "2": "第 13 轮 D_segment_expr 的「覆盖事件」数：事件内须全部 op 有 part 产物，叠加 7 口径的聚类混淆后只剩 2 个合格事件，属低估。按正确口径，段位表达式恢复只在合并档 10 op / 5 事件上有定义。"
 },
